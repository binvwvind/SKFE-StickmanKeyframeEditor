{
  "name": "skfe",
  "version": "7.0.4",
  "description": "SKFE | Stickman Keyframe Editor - 火柴人帧动画编辑器",
  "author": "binvwvind",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "sync": "node scripts/sync-www.js",
    "web": "npm run sync && node scripts/serve.js",
    "icons": "node scripts/make-icons.js",
    "dev:desktop": "npm run sync && electron .",
    "dist:win": "npm run sync && electron-builder --win --publish never",
    "cap:add:android": "npm run sync && cap add android",
    "cap:sync": "npm run sync && cap sync",
    "cap:open:android": "cap open android",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
